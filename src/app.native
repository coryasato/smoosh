<!-- M2 scaffold: every control M3-M8 need to drive via `native automate`.
     No styling/layout polish here on purpose — M9 replaces this wholesale
     with the real "UI sketch" from PLAN.md once every message actually
     works. Validate with: native check -->
<column gap="12" padding="16">
  <row gap="8" cross="center">
    <text grow="1">Smoosh</text>
    <button size="sm" variant="ghost" on-press="reset">Reset</button>
  </row>
  <button on-press="pick_file">Choose Image…</button>
  <toggle-group gap="4" label="Format">
    <for each="formats" as="f">
      <toggle-button selected="{f == format}" on-toggle="set_format:{f}">{f}</toggle-button>
    </for>
  </toggle-group>
  <row gap="8">
    <button variant="primary" on-press="smoosh">Smoosh</button>
    <button on-press="save_as">Save As…</button>
  </row>
  <status-bar>{statusLine}</status-bar>
</column>
